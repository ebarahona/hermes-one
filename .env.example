# hermes-one configuration (all connections, by ROLE not vendor). Copy to .env
# and override per environment. Dev defaults (in @hermes-one/config) match
# infra/docker-compose.yml, so a local run needs none of these; production sets
# them explicitly. The URL scheme carries the driver; swapping a store's vendor is
# a composition-root wiring change, not a config-shape change.

# Temporal
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# Authoritative store (compiled plans + authoritative state) — Postgres today
HERMES_AUTHORITATIVE_URL=postgres://hermes:hermes@127.0.0.1:5433/hermes

# Ephemeral store (cache / idempotency / locks / debounce / pub-sub) — Redis today
HERMES_EPHEMERAL_URL=redis://127.0.0.1:6380

# Vector store (embeddings) — Qdrant. Reserved: knowledge retrieval is planned; no component connects to it yet.
HERMES_VECTOR_URL=http://127.0.0.1:6333

# LLM (any OpenAI-compatible endpoint: OpenAI, Ollama, llama.cpp, vLLM, LM Studio, a gateway).
# The model must support tool calling. Examples are in the README, "LLM configuration".
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
LLM_API_KEY=local

# Transactional-outbox publisher. The loop drains per tenant under RLS;
# empty HERMES_OUTBOX_TENANTS disables it. Tenant list is a placeholder for the tenant registry (CT1/CT2).
HERMES_OUTBOX_TENANTS=
HERMES_OUTBOX_POLL_MS=1000
HERMES_OUTBOX_MAX_ATTEMPTS=10
HERMES_OUTBOX_CHANNEL_PATTERN=events:{tenantId}:{aggregateType}

# OpenTelemetry distributed tracing (OB5). off → NoopTracer;
# console → span tree to stdout (dev); otlp → ship to the collector at HERMES_OTEL_ENDPOINT (prod).
HERMES_OTEL_TRACES=off
HERMES_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Admin API (apps/admin-api). Listens on HERMES_ADMIN_API_HOST:PORT (0.0.0.0 in a container).
# HERMES_ADMIN_API_KEYS is a JSON array of {key, keyId, tenantId, principalId, scopes}: each key acts
# for one tenant with those scopes. HERMES_OIDC_ISSUERS is a JSON array of
# {issuer, audience, jwksUri, tenantClaim?, rolesClaim?} for bearer JWTs. With neither, every request 401s.
HERMES_ADMIN_API_HOST=127.0.0.1
HERMES_ADMIN_API_PORT=3001
HERMES_ADMIN_API_KEYS=
HERMES_OIDC_ISSUERS=

# Inbound webhook ingress (apps/api-gateway). HERMES_GATEWAY_NUMBERS maps each inbound number to its
# tenant as JSON ({"+15125550100":"tnt_..."}); a webhook to an unmapped number is dropped.
# HERMES_RULE_PARAMETERS holds per-tenant rule parameters as JSON ({"tnt_...":{"serviceZips":["75001"]}}).
HERMES_GATEWAY_HOST=127.0.0.1
HERMES_GATEWAY_PORT=3002
HERMES_GATEWAY_NUMBERS=
HERMES_RULE_PARAMETERS=

# Webhook signing secret (AUTH-1, docs/design/001-edge-authn-design.md). When the gateway is started
# without an inline secret it resolves secret://env/sms-webhook-signing → this variable via
# EnvSecretProvider (dev backend; the cloud secret manager swaps in behind the same SecretProvider port).
SMS_WEBHOOK_SIGNING=

# Tenant provider-credential encryption (ADR-026): 32-byte hex master key for the local envelope
# cipher. Present -> composition roots layer the per-tenant EnvelopeCredentialStore over the static
# env bundle; absent -> static only. Generate: openssl rand -hex 32
HERMES_CREDENTIALS_MASTER_KEY=
