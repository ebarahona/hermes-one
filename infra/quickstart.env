# Settings for the compose `app` profile (local evaluation only; replace every value for a real
# deployment). The admin key and webhook secret below are public: never expose these ports.
#
# One demo tenant (tnt_quickstart) owns the inbound number +15125550100, and one admin API key acts
# for it with the scopes needed to install and publish a vertical pack.
HERMES_ADMIN_API_KEYS=[{"key":"hermes-quickstart-admin-key","keyId":"apk_quickstart","tenantId":"tnt_quickstart","principalId":"prn_quickstart_admin","scopes":["definition.write","deployment.publish","deployment.read"]}]
HERMES_GATEWAY_NUMBERS={"+15125550100":"tnt_quickstart"}
SMS_WEBHOOK_SIGNING=hermes-quickstart-webhook-secret
