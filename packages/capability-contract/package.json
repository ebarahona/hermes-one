{
  "name": "@hermes-one/capability-contract",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/ebarahona/hermes-one/tree/main/packages/capability-contract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebarahona/hermes-one.git",
    "directory": "packages/capability-contract"
  },
  "bugs": {
    "url": "https://github.com/ebarahona/hermes-one/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.itest.*",
    "!dist/**/*.e2e.*",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public"
  },
  "hermes": {
    "name": "@hermes-one/capability-contract",
    "role": "package",
    "plane": "none",
    "published": true,
    "governedBy": [
      "ADR-016",
      "ADR-020"
    ]
  },
  "dependencies": {
    "@hermes-one/contracts": "workspace:*",
    "@hermes-one/expression-core": "workspace:*"
  }
}
