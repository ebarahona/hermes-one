              }
            }
          ],
          "defaultOutcome": "schedule",
          "parameters": [],
          "requiredFacts": ["intent"]
        }
      }
    ],
    "capabilities": [
      {
        "definitionId": "def_appt_slot_read",
        "kind": "capability",
        "name": "appointment-slot-read",
        "schemaRef": "appointment-slot-read.capability/v1",
        "version": "1.0.0",
        "body": {
          "name": "appointment.slot.read",
          "title": "Read appointment slots",
          "description": "List open service-visit slots for a given date and service type.",
          "inputJsonSchema": {
            "type": "object",
            "required": ["date"],
            "properties": {
              "date": {
                "type": "string"
              },
              "serviceType": {
                "type": "string"
              }
            }
          },
          "outputJsonSchema": {
            "type": "object",
            "properties": {
              "slots": {
                "type": "array"
              }
            }
          },
          "sideEffect": "read",
          "changedDomains": ["none"],
          "idempotency": {
            "required": false,
            "keyFields": [],
            "ttlSeconds": 86400
          },
          "confirm": false,
          "requiredScope": "appointment.slot.read",
          "providerMapping": {
            "providers": [
              {
                "providerId": "internal-scheduler",
                "priority": 100
              }
            ],
            "eligibility": [],
            "onNoProvider": "fail"
          }
        }
      }
    ]
  }
}
