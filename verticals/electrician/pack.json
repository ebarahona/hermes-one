                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "burning"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
