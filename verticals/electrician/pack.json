                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "appointment"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "slot"
                      }
                    ]
                  },
