    ],
    "capabilities": [
      {
        "definitionId": "def_support_reply_send",
        "kind": "capability",
        "name": "messaging-reply-send",
        "schemaRef": "messaging-reply-send.capability/v1",
        "version": "1.0.0",
        "body": {
          "name": "messaging.reply.send",
          "title": "Send a reply message",
          "description": "Send a templated reply to a customer on their channel.",
          "inputJsonSchema": {
            "type": "object",
            "required": ["to"],
            "properties": {
              "to": {"type": "string"},
              "template": {"type": "string"},
              "body": {"type": "string"}
            }
          },
          "outputJsonSchema": {
            "type": "object",
            "required": ["providerMessageId", "status"],
            "properties": {
              "providerMessageId": {"type": "string"},
              "status": {"type": "string"}
            }
          },
          "sideEffect": "external",
          "changedDomains": ["messaging", "conversation"],
          "idempotency": {
            "required": true,
            "keyFields": ["to", "template"],
            "ttlSeconds": 86400
          },
          "confirm": false,
          "requiredScope": "messaging.reply.send",
          "providerMapping": {
            "providers": [
              {"providerId": "twilio-sms", "priority": 200},
              {"providerId": "internal-message-log", "priority": 100}
            ],
            "eligibility": [],
            "onNoProvider": "fail"
          }
        }
      }
    ]
  }
