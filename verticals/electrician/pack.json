                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "book"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "available"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
