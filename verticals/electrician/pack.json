                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "smell"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "spark"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "shock"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "fire"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "exposed wire"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "buzzing"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "outcome": "schedule",
              "when": {
                "type": "or",
                "any": [
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
                        "op": "lower",
                        "args": [
                          {
                            "type": "fact",
                            "path": "intent"
                          }
                        ]
                      },
                      {
                        "type": "literal",
                        "value": "schedule"
                      }
                    ]
                  },
                  {
                    "type": "op",
                    "op": "contains",
                    "args": [
                      {
                        "type": "op",
