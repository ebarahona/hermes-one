{
  "name": "@hermes-one/workflow-dsl",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interpreter": {
      "types": "./dist/interpreter.d.ts",
      "import": "./dist/interpreter.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public"
  },
  "hermes": {
    "name": "@hermes-one/workflow-dsl",
    "role": "package",
    "plane": "none",
    "published": true,
    "governedBy": [
      "ADR-014"
    ]
  },
  "dependencies": {
    "@hermes-one/contracts": "workspace:*",
    "@hermes-one/definition-substrate": "workspace:*"
  },
  "devDependencies": {
    "@hermes-one/rule-dsl": "workspace:*",
    "@hermes-one/expression-core": "workspace:*"
  }
}
